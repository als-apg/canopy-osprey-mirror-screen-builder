# Base URL of the Canopy backend hosting the /converter API.
# Used by the "Import legacy screen…" flow to convert .edl/.ui files.
# Point this at a locally-run Canopy during development.
VITE_CANOPY_BASE_URL=http://127.0.0.1:8000

# API key sent as the X-API-Key header. The /converter route requires read
# access. Put the real value in a gitignored .env.local, not here.
# (A local Canopy started with CANOPY_API_KEYS="dev:read+write" uses key "dev".)
VITE_CANOPY_API_KEY=
